# Social Sentiment Radar: Configuration

# Mode: mock (default offline deterministic), reddit_api, or twitter_api
RADAR_SOURCE=mock

# Reddit API Credentials (optional for live scraping)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentiment-radar:v0.1.0

# Twitter / X API Bearer Token (optional)
TWITTER_BEARER_TOKEN=
